---
import ProfessionalPage from '../../components/ProfessionalPage.astro';
export function getStaticPaths() {
  return ['about', 'projects', 'speaking', 'events'].map((page) => ({ params: { page } }));
}
const page = Astro.params.page as 'about' | 'projects' | 'speaking' | 'events';
---

<ProfessionalPage locale="es" page={page} />
