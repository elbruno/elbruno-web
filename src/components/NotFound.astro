---
import Layout from '../layouts/Layout.astro';
import { route, t, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);
---

<Layout locale={locale} title="404" notFound>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">404 / {locale === 'en' ? 'page not found' : 'página no encontrada'}</p>
      <h1>{text.notFound}</h1>
      <p>{text.notFoundText}</p>
      <a class="button primary" style="margin-top: 25px" href={route(locale)}>
        {text.back}
      </a>
    </div>
  </section>
</Layout>
