---
import { t, type Locale } from '../i18n';
import { isExternalBlog } from '../lib/links';
interface Props {
  href: string;
  locale: Locale;
  newTab?: boolean;
  class?: string;
}
const { href, locale, newTab: requestedNewTab = false, class: className } = Astro.props;
const newTab = requestedNewTab || isExternalBlog(href);
---

<a
  href={href}
  class={className}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
>
  <slot />
  {newTab && <span class="sr-only"> ({t(locale).newTab})</span>}
</a>
