---
import { conference, talks, foundrySeries, botSeries, talkDate, talkTime } from '../data/talks';
import { events } from '../data/events';
import { selectEvents } from '../lib/events';
import EventCard from './EventCard.astro';
import Icon from './Icon.astro';
import { route, t, type Locale } from '../i18n';
interface Props {
  locale: Locale;
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const text = t(locale);
const upcoming = selectEvents(events, { view: 'upcoming' });
---

<section
  class="section talks-section"
  data-talks
  data-status-labels={JSON.stringify(text.eventStatus)}
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">{text.streamsEyebrow}</p>
      <h2>{text.eventsTitle}</h2>
      <p>{text.eventsDescription}</p>
    </div>
    <a class="small-link" href={route(locale, 'events')}>
      {text.allEventsLink}
      <Icon name="arrow" size={17} />
    </a>
  </div>
  <section class="event-group" aria-labelledby="upcoming-events-heading">
    <h3 id="upcoming-events-heading">{text.upcomingEvents}</h3>
    <div class="events-grid" data-upcoming-list>
      {upcoming.map((event) => (
        <EventCard event={event} locale={locale} heading="h4" />
      ))}
    </div>
    <p class="empty-state" data-no-upcoming hidden={upcoming.length > 0}>
      {text.noUpcomingEvents}
    </p>
  </section>
  <div class="event-series-links">
    <p>
      <a href={foundrySeries.url}>{foundrySeries.title}</a> · {foundrySeries.summary[locale]}
    </p>
    <p>
      <a href={botSeries.url}>{botSeries.title}</a> · {botSeries.summary[locale]}
    </p>
  </div>
  <section class="event-group" aria-labelledby="past-highlights-heading">
    <h3 id="past-highlights-heading">{text.pastHighlights}</h3>
    <article class="card stream-card" data-stream-series="conference">
      <div class="stream-card-heading">
        <span class="mini-icon">
          <Icon name="mic" size={24} />
        </span>
        <p class="eyebrow">
          {text.onlineConference} · {conference.name}
        </p>
      </div>
      <p class="stream-summary">{text.conferenceDescription}</p>
      <ul class="stream-sessions conference-highlights">
        {talks.map((talk) => (
          <li class="talk-entry">
            <h4 lang="en">
              <a href={talk.url}>{talk.title}</a>
            </h4>
            <p class="talk-date">
              <time datetime={talk.start}>{talkDate(talk.start, locale)}</time>
              {' · '}
              {talkTime(talk.start)}–{talkTime(talk.end)} PST
            </p>
            <p class="talk-video-link">
              <a class="small-link" href={talk.videoUrl}>
                {text.watchSession}
              </a>
            </p>
            {!compact && <p>{talk.summary[locale]}</p>}
          </li>
        ))}
      </ul>
      <div class="actions conference-actions">
        <a class="button secondary" href={conference.url}>
          {text.exploreConference}
        </a>
      </div>
    </article>
  </section>
  <p class="stream-timezone">{text.streamsTimezone}</p>
</section>

<script>
  import { events } from '../data/events';
  import { eventStatus } from '../lib/events';

  function updateTalks() {
    for (const section of document.querySelectorAll<HTMLElement>('[data-talks]')) {
      const labels = JSON.parse(section.dataset.statusLabels!) as Record<
        ReturnType<typeof eventStatus>,
        string
      >;
      const now = Date.now();
      const cards = section.querySelectorAll<HTMLElement>('[data-event-id]');
      for (const card of cards) {
        const event = events.find((event) => event.id === card.dataset.eventId)!;
        const status = eventStatus(event, now);
        card.hidden = status === 'past';
        card.querySelector('[data-event-status]')!.textContent = labels[status];
      }
      section.querySelector<HTMLElement>('[data-no-upcoming]')!.hidden = [...cards].some(
        (card) => !card.hidden,
      );
    }
  }
  updateTalks();
  window.setInterval(updateTalks, 30_000);
  document.addEventListener('visibilitychange', updateTalks);
</script>
