---
import Layout from '../layouts/Layout.astro';
import ProjectCard from './ProjectCard.astro';
import SpeakerKit from './SpeakerKit.astro';
import Icon from './Icon.astro';
import PackageSection from './PackageSection.astro';
import ResourceLink from './ResourceLink.astro';
import Talks from './Talks.astro';
import { profile, projects } from '../data/profile';
import { careerEntries, selectedWork } from '../data/cv';
import { route, t, type Locale, type Page } from '../i18n';
interface Props {
  locale: Locale;
  page: Exclude<Page, ''>;
}
const { locale, page } = Astro.props;
const text = t(locale);
const headings = {
  about: text.aboutTitle,
  projects: text.projectsTitle,
  speaking: text.speakingTitle,
};
const descriptions = {
  about: text.aboutDescription,
  projects: text.projectsDescription,
  speaking: text.speakingDescription,
};
---

<Layout locale={locale} page={page} title={text.nav[page]} description={descriptions[page]}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{text.nav[page]} / Bruno Capuano</p>
      <h1>{headings[page]}</h1>
      <p>{descriptions[page]}</p>
    </div>
  </section>
  <div class="container page-content">
    {page === 'about' && (
      <>
        <section class="about-grid section">
          <div class="prose">
            <h2>{text.storyHeading}</h2>
            <p>{text.bio1}</p>
            <p>{text.bio2}</p>
            <p>
              {text.confHighlight}{' '}
              <a href={`${route(locale, 'speaking')}#sessions`}>{text.sessionDetails}</a>
            </p>
            <p>
              {text.aboutLibraries}{' '}
              <a href={`${route(locale, 'projects')}#libraries`}>{text.allLibraries}</a>
            </p>
            <div class="actions">
              <a class="button primary" href={profile.linkedin}>
                {text.connect}
                <Icon name="arrow" size={18} />
              </a>
              <a class="button secondary" href={route(locale, 'speaking')}>
                {text.speakerKit}
              </a>
            </div>
          </div>
          <figure class="about-headshot">
            <img
              src="/assets/photos/speaker-headshot-480.webp"
              srcset="/assets/photos/speaker-headshot-480.webp 480w, /assets/photos/speaker-headshot-960.webp 960w"
              sizes="(max-width: 780px) 280px, 360px"
              alt={text.officialHeadshotAlt}
              width="480"
              height="640"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{text.officialHeadshot}</figcaption>
          </figure>
        </section>
        <section class="section cv-section">
          <div class="section-heading">
            <div>
              <h2>{text.experience}</h2>
              <p>{text.experienceIntro}</p>
            </div>
          </div>
          <ol class="career-list">
            {careerEntries
              .filter((entry) => entry.verified)
              .map((entry) => (
                <li class="card career-entry">
                  <p class="eyebrow">{text.currentPosition}</p>
                  <h3>{entry.role[locale]}</h3>
                  <p class="career-organization">{entry.organization}</p>
                  <p>{entry.summary[locale]}</p>
                  <a class="small-link" href={entry.source}>
                    {text.verifyProfile}
                    <Icon name="arrow" size={16} />
                  </a>
                </li>
              ))}
          </ol>
          <p class="editorial-note">{text.earlierCareerPending}</p>
        </section>
        <section class="section cv-section">
          <div class="section-heading">
            <div>
              <h2>{text.selectedWork}</h2>
              <p>{text.selectedWorkIntro}</p>
            </div>
          </div>
          <div class="cv-work-grid">
            {selectedWork.map((item) => (
              <article class="card cv-work-card">
                <p class="eyebrow">{item.type[locale]}</p>
                <h3>{item.name}</h3>
                <p>{item.description[locale]}</p>
                <ResourceLink
                  class="small-link"
                  href={item.href}
                  locale={locale}
                  newTab={new URL(item.href).hostname === new URL(profile.podcast).hostname}
                >
                  {text.viewWork}
                  <Icon name="arrow" size={16} />
                </ResourceLink>
              </article>
            ))}
          </div>
        </section>
        <section class="section">
          <div class="section-heading">
            <h2>{text.skills}</h2>
          </div>
          <ul class="expertise-list">
            {text.expertise.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </section>
        <section class="section personal-roots">
          <h2>{text.countriesTitle}</h2>
          <p>{text.countriesText}</p>
        </section>
        <section class="section about-stories">
          <div class="section-heading">
            <div>
              <h2>{text.beyond}</h2>
              <p>{text.beyondText}</p>
            </div>
          </div>
          <div class="about-photo-grid">
            <article class="card about-photo-card">
              <img
                src="/assets/photos/about-community-960.webp"
                alt={text.communityPhotoText}
                width="960"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3>{text.communityPhotoTitle}</h3>
                <p>{text.communityPhotoText}</p>
              </div>
            </article>
            <article class="card about-photo-card">
              <img
                src="/assets/photos/about-ultra-run-600.webp"
                srcset="/assets/photos/about-ultra-run-600.webp 600w, /assets/photos/about-ultra-run-900.webp 900w"
                sizes="(max-width: 480px) 108px, (max-width: 780px) 50vw, 25vw"
                alt={text.runningPhotoText}
                width="600"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3>{text.runningPhotoTitle}</h3>
                <p>{text.runningPhotoText}</p>
              </div>
            </article>
            <article class="card about-photo-card">
              <img
                src="/assets/photos/about-ace-600.webp"
                srcset="/assets/photos/about-ace-600.webp 600w, /assets/photos/about-ace-900.webp 900w"
                sizes="(max-width: 480px) 108px, (max-width: 780px) 50vw, 25vw"
                alt={text.acePhotoText}
                width="600"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3>{text.acePhotoTitle}</h3>
                <p>{text.acePhotoText}</p>
              </div>
            </article>
            <article class="card about-photo-card winter-photo-card">
              <img
                src="/images/personal/canadian-winters-908.webp"
                srcset="/images/personal/canadian-winters-600.webp 600w, /images/personal/canadian-winters-908.webp 908w"
                sizes="(max-width: 780px) 100vw, 50vw"
                alt={text.winterPhotoAlt}
                width="908"
                height="302"
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3>{text.winterTitle}</h3>
                <p>{text.winterText}</p>
              </div>
            </article>
          </div>
        </section>
      </>
    )}
    {page === 'projects' && (
      <>
        <section class="section">
          <p class="notice">{text.projectsNote}</p>
          <div class="projects-grid" style="margin-top: 30px">
            {projects.map((project) => (
              <ProjectCard project={project} locale={locale} />
            ))}
          </div>
          <a class="small-link" style="margin-top: 30px" href={profile.github}>
            GitHub <Icon name="arrow" size={17} />
          </a>
        </section>
        <PackageSection locale={locale} />
      </>
    )}
    {page === 'speaking' && (
      <>
        <div id="sessions">
          <Talks locale={locale} />
        </div>
        <SpeakerKit locale={locale} />
      </>
    )}
  </div>
</Layout>
