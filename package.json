{
  "name": "elbruno-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build-speaker-kit": "tsx scripts/create-speaker-kit.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "refresh-content": "tsx scripts/fetch-content.ts",
    "validate-content": "tsx scripts/validate-content.ts",
    "validate": "npm run check && npm run lint && npm run test && npm run validate-content && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-xml-parser": "5.11.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
